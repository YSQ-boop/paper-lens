{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper Lens reviewed online evaluation baseline",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "created_at",
    "evaluation_date",
    "git_commit",
    "codex_version",
    "model",
    "judge_model",
    "selected_case_ids",
    "results",
    "usage",
    "passed"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"const": "online"},
    "created_at": {"type": "string", "minLength": 1},
    "evaluation_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "git_commit": {"type": "string", "minLength": 1},
    "codex_version": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "judge_model": {"type": "string", "minLength": 1},
    "selected_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "passed"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["positive", "negative"]},
          "passed": {"type": "boolean"},
          "deterministic_validation": {"type": "boolean"},
          "judgment": {
            "type": "object",
            "required": [
              "grounding",
              "coverage",
              "uncertainty",
              "formula_table_accuracy",
              "overall",
              "unsupported_claims"
            ],
            "properties": {
              "grounding": {"type": "integer", "minimum": 1, "maximum": 5},
              "coverage": {"type": "integer", "minimum": 1, "maximum": 5},
              "uncertainty": {"type": "integer", "minimum": 1, "maximum": 5},
              "formula_table_accuracy": {"type": "integer", "minimum": 1, "maximum": 5},
              "overall": {"type": "integer", "minimum": 1, "maximum": 5},
              "unsupported_claims": {
                "type": "array",
                "items": {"type": "string"}
              }
            }
          },
          "usage": {
            "type": "object",
            "required": ["author", "judge"],
            "properties": {
              "author": {"$ref": "#/$defs/tokenCounters"},
              "judge": {"$ref": "#/$defs/tokenCounters"}
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "positive"}}},
            "then": {
              "required": ["deterministic_validation", "judgment", "usage"]
            }
          }
        ]
      }
    },
    "usage": {
      "type": "object",
      "required": ["author", "judge", "total"],
      "properties": {
        "author": {"$ref": "#/$defs/tokenCounters"},
        "judge": {"$ref": "#/$defs/tokenCounters"},
        "total": {"$ref": "#/$defs/tokenCounters"}
      }
    },
    "passed": {"type": "boolean"}
  },
  "$defs": {
    "tokenCounters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  }
}
